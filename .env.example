# ─────────────────────────────────────────────────────────────────────────────
# Interview Trainer Agent — Environment Configuration Template
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# IBM watsonx.ai API Key
# Get this from: IBM Cloud → Manage → Access (IAM) → API keys
WATSONX_API_KEY=

# watsonx.ai Project ID
# Get this from: watsonx.ai → Project → Manage → General → Project ID
WATSONX_PROJECT_ID=

# LLM Model ID to use for generation
# Currently using: meta-llama/llama-3-3-70b-instruct
# To switch to Granite when available, change ONLY this value — no code changes needed.
# Example: ibm/granite-13b-instruct-v2
WATSONX_MODEL_ID=

# Full watsonx.ai generation endpoint (include the path and version query string exactly as shown)
# Example: https://eu-gb.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29
WATSONX_URL=
